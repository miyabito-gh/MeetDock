{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeetDock",
  "version": "0.1.0",
  "identifier": "com.meetdock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "MeetDock",
      "width": 1440,
      "height": 900,
      "minWidth": 960,
      "minHeight": 640,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
